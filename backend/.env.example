# Healthcare Greenfield Enterprise RAG - Backend Environment Variables

# Database Configuration (PostgreSQL)
# Local development default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/healthcare_rag
# If running through Docker:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/healthcare_rag

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
# If running through Docker:
# QDRANT_URL=http://qdrant:6333

# LLM Provider Configuration ("gemini", "openai", or "mock")
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash

# API & Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
LOG_LEVEL=INFO
